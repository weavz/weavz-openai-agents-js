# Custom Weavz MCP endpoint and MCP access token returned by your setup.
# This is not a Weavz REST API key (wvz_...).
WEAVZ_MCP_URL=https://your-custom-mcp-endpoint.example/mcp
WEAVZ_MCP_TOKEN=replace-with-mcp-access-token

# Only needed for a live agent run; fixture tests and tool discovery need no model key.
OPENAI_API_KEY=your-model-provider-key
OPENAI_MODEL=your-provider-model-id
